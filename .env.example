# Template de variáveis de ambiente. Copie para apps/api-rls/.env e
# apps/api-middleware/.env e ajuste os valores de cada uma (porta e
# conexão com o banco são diferentes entre as duas APIs).
#
# NUNCA preencha estes valores aqui neste arquivo nem faça commit de um
# .env com valores reais — .env já está no .gitignore.

# Connection string do Postgres do Supabase.
# api-rls: use o role app_rls_client (ver supabase/migrations e docs/POLITICAS_RLS.md).
#          Usar o role `postgres`/`service_role` faz o RLS ser ignorado silenciosamente.
# api-middleware: role equivalente do cenário middleware (RLS desabilitado) — a criar.
# Host/porta/nome do banco: painel do Supabase > Project Settings > Database.
DATABASE_URL=postgresql://app_rls_client:<senha>@<host>:5432/postgres

# Porta local da API (api-rls=3001, api-middleware=3002 sugerido)
PORT=3001

# Segredo usado para assinar/validar os JWTs de teste (npm run token / gerador
# de seed). Use o MESMO valor nas duas APIs: o mesmo token precisa valer nas duas.
JWT_SECRET=<gere um segredo forte>

# Opcionais — devem ter o mesmo valor nas duas APIs (variáveis controladas):
# DB_POOL_MAX=10        # tamanho máximo do pool de conexões
# DATABASE_SSL=true     # false só para Postgres local sem SSL

# Volume de dados atualmente carregado no banco (10000 | 50000 | 100000)
# — informativo, usado pelos scripts de seed/relatório para nomear os runs.
DATA_VOLUME=10000
